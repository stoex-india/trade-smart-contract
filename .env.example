# Copy to `.env` and fill in real values. Never commit `.env`.
# forge scripts use `vm.envUint("PRIVATE_KEY")` — use hex with 0x prefix.

# --- Network ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Required only when using `forge script ... --verify` (matches `foundry.toml` [etherscan] amoy).
# Create a key at https://polygonscan.com/apis (Amoy / Polygon PoS).
POLYGONSCAN_API_KEY=

# --- Deploy (DeployAmoy.s.sol) ---
# Deployer key; stored on-chain as `deployer` (no admin rights until handoff).
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# Operations admin (setInitialAdmin). Omit this entire line to use the deployer address as admin.
# INITIAL_ADMIN=0x...

# Optional deploy routing (defaults shown in script if unset)
# ASSET_PROVIDER_PAYOUT=0x...
# REDEEM_SINK=0x000000000000000000000000000000000000dEaD
# VAULT_BOOKKEEPING=0x...
# FORWARDER_NAME=STOEX Forwarder

# --- After deploy: paste logged proxy addresses ---
GOVERNANCE_CONFIG=0x0000000000000000000000000000000000000000
WHITELIST_REGISTRY=0x0000000000000000000000000000000000000000
GOLD_NFT=0x0000000000000000000000000000000000000000
ESCROW_VAULT=0x0000000000000000000000000000000000000000
TIMELOCK_CONTROLLER=0x0000000000000000000000000000000000000000
TRADE_MANAGER=0x0000000000000000000000000000000000000000
ERC2771_FORWARDER=0x0000000000000000000000000000000000000000

# --- ConfigureRoles.s.sol (use admin PRIVATE_KEY) ---
ROLE_AP=0x0000000000000000000000000000000000000000
ROLE_VP=0x0000000000000000000000000000000000000000
ROLE_AT=0x0000000000000000000000000000000000000000
ROLE_PAP=0x0000000000000000000000000000000000000000
ROLE_AUDITOR=0x0000000000000000000000000000000000000000
# ERC2771_FORWARDER=0x...   # set only when rotating forwarder

# --- OnboardInvestors.s.sol ---
# INVESTOR_1=0x...
# INVESTOR_1_KYC_REF=KYC-1
# INVESTOR_1_VERIFY_KYC=false
# INVESTOR_2=0x...
# INVESTOR_2_KYC_REF=KYC-2
# INVESTOR_2_VERIFY_KYC=true
# SKIP_KYC_VERIFY=false     # global default; per-investor INVESTOR_<n>_VERIFY_KYC overrides this

# --- Operation flows (BuyFlow, SellFlow, etc.) ---
USER_PRIVATE_KEY=0xYOUR_INVESTOR_PRIVATE_KEY
# ADMIN_PRIVATE_KEY=0x...   # optional; else flows use PRIVATE_KEY for admin execute
# AP_PRIVATE_KEY=0x...
# VP_PRIVATE_KEY=0x...
# AT_PRIVATE_KEY=0x...
# PAP_PRIVATE_KEY=0x...

# --- GovernanceAdminFlags.s.sol ---
# GOVERNANCE_CONFIG=0x...   # same as above
# VP_REQUIRED=false         # vm.envBool: true or false

# --- MintFlow.s.sol ---

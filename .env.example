# Copy to `.env` and fill in real values. Never commit `.env`.
# forge scripts use `vm.envUint("PRIVATE_KEY")` — use hex with 0x prefix.

# --- Network ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# --- Deploy (DeployAmoy.s.sol) ---
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# Operations admin (setInitialAdmin / transferAdmin target)
INITIAL_ADMIN=0x...

# Default provider on fresh deploy
DEFAULT_PROVIDER_LABEL=AP1
DEFAULT_PROVIDER_NAME=MMTC
# ROLE_AP=0x...                 # optional operator; omit to register provider without operator
# ASSET_PROVIDER_PAYOUT=0x...
# REDEEM_SINK=0x000000000000000000000000000000000000dEaD

# --- After deploy: paste logged proxy addresses ---
GOVERNANCE_CONFIG=0x0000000000000000000000000000000000000000
ASSET_REGISTRY=0x0000000000000000000000000000000000000000
ASSET_PROVIDER_REGISTRY=0x0000000000000000000000000000000000000000
WHITELIST_REGISTRY=0x0000000000000000000000000000000000000000
ASSET_LEDGER=0x0000000000000000000000000000000000000000
ESCROW_VAULT=0x0000000000000000000000000000000000000000
TIMELOCK_CONTROLLER=0x0000000000000000000000000000000000000000
TRADE_MANAGER=0x0000000000000000000000000000000000000000

# --- OnboardInvestors.s.sol ---
# INVESTOR_1=0x...
# INVESTOR_1_KYC_REF=KYC-1
# INVESTOR_1_VERIFY_KYC=false

# --- Operation flows ---
# USER_PRIVATE_KEY=0x...
# ADMIN_PRIVATE_KEY=0x...

# Tresori gasless
RELAYER_SMART_CONTRACT=0x0000000000000000000000000000000000000000
FACILITATOR_SMART_CONTRACT=0x0000000000000000000000000000000000000000
ERC2771_FORWARDER=0x0000000000000000000000000000000000000000

# Copy to relayer/.env and fill in values.

PORT=8787
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
RELAYER_PRIVATE_KEY=0x...

# OpenZeppelin ERC2771Forwarder deployment
ERC2771_FORWARDER=0x...

# Must match the `name` passed to the forwarder constructor (see DeployAmoy FORWARDER_NAME)
FORWARDER_EIP712_NAME=STOEX Forwarder
FORWARDER_EIP712_VERSION=1

# Path to operations + contract addresses JSON
OPERATIONS_CONFIG=./config/operations.json

# Optional: require clients to send header x-api-key (or Authorization: Bearer ...)
# RELAYER_API_KEY=

# Optional: behind reverse proxy
# TRUST_PROXY=true

# Optional: browser CORS (comma-separated origins, or * for any)
# CORS_ORIGIN=http://localhost:3000

# Optional rate limit (defaults: 15 min window, 200 req / IP)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
